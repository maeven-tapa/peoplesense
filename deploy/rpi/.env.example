PEOPLESENSE_HARDWARE=1
PEOPLESENSE_HOTSPOT=1
PEOPLESENSE_VISION_BACKEND=litert
PEOPLESENSE_SERVO_MIN=10
PEOPLESENSE_SERVO_MAX=170
PEOPLESENSE_SERVO_MIN_PULSE=0.001
PEOPLESENSE_SERVO_MAX_PULSE=0.002
PEOPLESENSE_PAN_REVERSED=0
PEOPLESENSE_TILT_REVERSED=0
PEOPLESENSE_PROXY_HTTPS=0
# Local LAN commissioning. Enable HTTPS and DEBUG=0 for production.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,peoplesense.local,10.0.0.1
DJANGO_SECRET_KEY=replace-with-a-random-secret
